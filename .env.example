# Ultamail webmail: https://ultamail.com/appsuite/
# Copy to .env.local and fill in. Do not commit .env.local.
# Quote SMTP_PASS if it contains # ! or spaces, e.g. SMTP_PASS="your-pass"
SMTP_HOST=smtp.ultamail.com
SMTP_PORT=587
SMTP_USER=hello@genixalab.com
SMTP_PASS=
# Optional overrides (defaults to SMTP_USER). Prefer a real inbox for SMTP_TO.
# SMTP_FROM=hello@genixalab.com
# SMTP_TO=hello@genixalab.com
